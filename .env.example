# Copy to .env before the first run:  cp .env.example .env
# Local throwaway values only. Never put a real credential here or in .env.

# Postgres, created by the db container on first start.
# Keep the password URL-safe (letters, digits, - and _): it is placed inside DATABASE_URL.
POSTGRES_USER=aangan
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=aangan

# Ports published on 127.0.0.1. Change them if they are taken on your machine.
WEB_PORT=3000
API_PORT=4000
DB_PORT=5433

# API
LOG_LEVEL=info

# Only for running the API on the host (npm run dev) against the compose database.
# It must repeat the POSTGRES_* values and DB_PORT above; update it if you change them.
# Inside compose, the API gets its own DATABASE_URL pointing at db:5432.
DATABASE_URL=postgres://aangan:change-me-local-only@localhost:5433/aangan

# Donation intake. These are the defaults; uncomment to change them when running the API on
# the host (npm run dev). The compose stack does not pass them on, so it always uses these.
# ORG_TIMEZONE=America/Chicago
# PAYMENT_TIMEOUT_MS=5000
# PAYMENT_MOCK_LATENCY_MS=250
# DONATION_RATE_LIMIT=30

# Login and origins (spec 005). Defaults shown. ALLOWED_ORIGINS applies to `npm run dev` only; compose
# builds its own list from WEB_PORT. Set COOKIE_SECURE=false only if your browser drops Secure cookies on
# http://localhost (some Safari versions); compose passes this one on.
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# SESSION_TTL_HOURS=8
# COOKIE_SECURE=true
# LOGIN_RATE_LIMIT=20
