# Copy to .env before the first run:  cp .env.example .env
# Local throwaway values only. Never put a real credential here or in .env.

# Postgres, created by the db container on first start.
# Keep the password URL-safe (letters, digits, - and _): it is placed inside DATABASE_URL.
POSTGRES_USER=aangan
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=aangan

# Ports published on 127.0.0.1. Change them if they are taken on your machine.
WEB_PORT=3000
API_PORT=4000
DB_PORT=5433

# API
LOG_LEVEL=info

# Only for running the API on the host (npm run dev) against the compose database.
# It must repeat the POSTGRES_* values and DB_PORT above; update it if you change them.
# Inside compose, the API gets its own DATABASE_URL pointing at db:5432.
DATABASE_URL=postgres://aangan:change-me-local-only@localhost:5433/aangan
